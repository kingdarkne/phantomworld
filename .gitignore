# Runtime / host-provided — never commit (FXServer comes from the game panel)
/alpine/
/citizen/
/components/
/FXServer.exe
/run.cmd

# Rebuilt on the server — huge and not needed in git
cache/
tmp/
/crashes/
logs/
db/
txData/

# Logs and editor noise
*.log
.DS_Store
Thumbs.db
desktop.ini
Desktop.ini
.vscode/
.idea/
.replxx_history

# Dev deps (tracked web/dist bundles are fine)
**/node_modules/
**/.yarn/
**/.cache/

# Secrets not in repo (mysql.cfg + secrets.cfg ARE tracked — private repo)
.env
.env.*
*.pem
*.key
server.cfg.local

# Accidental crash dumps (not scripts)
resources/core
resources/y_burgershot-main/core
**/qb-core-legacy/core

# Duplicate / backup trees
**/*__duplicate_backup/
**/*_backup/

# Large asset packs — upload once via SFTP to host; too big for GitHub
resources/\[vehicles\]/
resources/\[clothing\]/
resources/\[Graphics\]/
resources/\[defaultmaps\]/
resources/AzuraPlatV2-Branded/
resources/FiveM Vehicle Pack/
resources/cars2/
resources/Audio_Pack/
resources/\[Newmaps\]/\[qb\]/
