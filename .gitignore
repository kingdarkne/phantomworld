.env
.env.*
*.pem
*.key
server.cfg.local

# Node / build artifacts inside resources
**/node_modules/
**/.yarn/
**/dist/
**/.cache/

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Editor
.vscode/
.idea/
