# Copy to .env and fill in (never commit .env)

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_STATUS_CHANNEL_ID=

# FiveM HTTP API (phantom_dashboard resource)
FIVEM_SERVER_URL=http://127.0.0.1:30120
