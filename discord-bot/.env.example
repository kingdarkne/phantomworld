# Copy to .env on the host (never commit .env)

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_OWNER_USER_ID=

# Privileged intents (enable in Discord Developer Portal):
# - Server Members Intent (invite DMs)
# - Message Content Intent ($ prefix commands + AI channel)

DISCORD_STATUS_CHANNEL_ID=
DISCORD_AI_CHANNEL_ID=

# Prefix commands (default $)
COMMAND_PREFIX=$

# FiveM HTTP API (phantom_dashboard) — same machine as FXServer
FIVEM_SERVER_URL=http://127.0.0.1:30120
FIVEM_API_TOKEN=

# Must match phantom_dashboard:apiToken in server secrets cfg
BOT_RELAY_SECRET=

# Local relay port (FiveM posts events here for owner DMs)
BOT_HTTP_PORT=3099

# Optional CFX listing fallback
CFX_SERVER_ID=3m87mo
PHANTOM_SERVER_NAME=Phantom World

# Live status embed channel
STATUS_LIVE_POLL_SECONDS=60
FIVEM_LIVE_PRESENCE=1

# Lavalink on VPS (same host as bot — use 127.0.0.1)
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=phantomworld
LAVALINK_SECURE=0

# AI — Ollama on VPS (default) or OpenAI-compatible API
AI_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# AI_API_URL=http://127.0.0.1:PORT/v1
# AI_API_KEY=

# Voice TTS ($say) — auto tries TTS_API_URL, OpenAI, then Edge TTS
# TTS_API_URL=http://127.0.0.1:PORT/tts
# TTS_PROVIDER=auto
# OPENAI_API_KEY=

# Auto status channel posts (minutes, 0 = off)
STATUS_POLL_MINUTES=0

# Bot presence: poll server + rotate activity text (seconds)
PRESENCE_POLL_SECONDS=60
PRESENCE_ROTATE_SECONDS=25

# Optional GIF search
GIPHY_API_KEY=

# Server invite DMs
SERVER_INVITE_DM_ON_START=0
SERVER_INVITE_DM_COOLDOWN_HOURS=168
SERVER_INVITE_DM_DELAY_MS=1500
