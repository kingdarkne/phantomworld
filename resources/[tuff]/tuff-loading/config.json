  "news": [
    {
      "title": "🎉 Welcome to Phantom World!",
      "description": "Join our thriving community with custom heists, gang wars, vehicle customization, and much more! Connect with us on Discord for updates and events.",
      "image": "https://r2.fivemanage.com/egIfenr31HG7UeqR4GDz5/1LoadingScreenThumbnail.png",
      "date": "5/8/2026"
    },
    {
      "title": "🚗 New Vehicle Calling Menu",
      "description": "Spawning your owned and rented vehicles is now easier than ever! Press F3 to access the new vehicle calling menu.",
      "image": "https://r2.fivemanage.com/egIfenr31HG7UeqR4GDz5/stanverv2gif-ezgif.com-optimize.gif",
      "date": "5/8/2026"
    },
    {
      "title": "🔫 GTA-Online Style Weapon Wheel",
      "description": "Experience the authentic GTA V weapon wheel with smooth animations and inventory integration. Press TAB to access your arsenal.",
      "image": "https://r2.fivemanage.com/egIfenr31HG7UeqR4GDz5/Emoji.gif",
      "date": "5/8/2026"
    },
    {
      "title": "🏠 Custom Garage System",
      "description": "Store and customize your vehicles in GTA Online style garages. Multiple garage locations available across Los Santos!",
      "image": "https://r2.fivemanage.com/egIfenr31HG7UeqR4GDz5/1LoadingScreenThumbnail.png",
      "date": "5/8/2026"
    },
    {
      "title": "💰 Bank Heists & Jewelry Robberies",
      "description": "Plan and execute high-stakes heists with your crew. Fleeca Bank, Pacific Standard, and Jewelry Store robberies available.",
      "image": "https://r2.fivemanage.com/egIfenr31HG7UeqR4GDz5/stanverv2gif-ezgif.com-optimize.gif",
      "date": "5/8/2026"
    }
  ],

