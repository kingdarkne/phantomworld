    {
      "version": "1.0.0",
      "date": "5/8/2026",
      "changes": [
        "Initial server launch",
        "Added custom weapon wheel system",
        "Implemented vehicle calling menu",
        "Added GTA Online style garages",
        "Integrated bank heists and jewelry robberies",
        "Added gang territory wars system",
        "Implemented cops vs robbers arena",
        "Added custom HUD and scoreboard",
        "Integrated Tuff Scripts suite",
        "Added multicharacter system"
      ]
    },
    {
      "version": "1.0.1",
      "date": "5/8/2026",
      "changes": [
        "Fixed spawn sequence for smooth character entry",
        "Improved multicharacter UI with React build",
        "Fixed inventory integration for weapons",
        "Added vehicle calling menu for owned/rented cars",
        "Improved loading screen with custom branding",
        "Added staff team section",
        "Added changelog system",
        "Fixed syntax errors in phantom_core"
      ]
    }
