# Copy to phantom_dashboard.secrets.cfg on the game server host.
# Do not commit the real secrets file (gitignored).

set phantom_dashboard:webhook "https://discord.com/api/webhooks/YOUR_WEBHOOK"
set phantom_dashboard:apiToken "generate-a-long-random-token"
# Empty = no relay (Gravelhost FiveM + PC bot). Only set if discord-bot Node runs on same host as FXServer:
# set phantom_dashboard:botRelayUrl "http://127.0.0.1:3099/events"
set phantom_dashboard:botRelayUrl ""
# Public listing for PC /status fallback: https://cfx.re/join/3m87mo
set phantom_dashboard:ownerDiscordId "YOUR_DISCORD_USER_ID"
set phantom_dashboard:botToken "YOUR_BOT_TOKEN_FOR_DIRECT_DMS"
set phantom_dashboard:postStartup 1
set phantom_dashboard:alertAllEvents 1
set phantom_dashboard:alertMinPlayers 0
# Error reporting (SCRIPT ERROR / console failures → Discord via webhook + bot /events)
set phantom_dashboard:errorReporting 1
# Optional separate #server-errors webhook (falls back to :webhook if empty)
# set phantom_dashboard:errorWebhook "https://discord.com/api/webhooks/YOUR_ERROR_WEBHOOK"
set phantom_dashboard:errorDebounceSeconds 45
set phantom_dashboard:errorBootGraceSeconds 90
