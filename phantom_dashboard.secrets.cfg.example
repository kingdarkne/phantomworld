# Copy to phantom_dashboard.secrets.cfg on the game server host.
# Do not commit the real secrets file (gitignored).

set phantom_dashboard:webhook "https://discord.com/api/webhooks/YOUR_WEBHOOK"
set phantom_dashboard:apiToken "generate-a-long-random-token"
# Leave empty when botToken is set (Gravelhost FiveM + PC bot). Relay only works if Node runs on the game host.
set phantom_dashboard:botRelayUrl ""
set phantom_dashboard:ownerDiscordId "YOUR_DISCORD_USER_ID"
set phantom_dashboard:botToken "YOUR_BOT_TOKEN_FOR_DIRECT_DMS"
set phantom_dashboard:postStartup 1
set phantom_dashboard:alertAllEvents 1
set phantom_dashboard:alertMinPlayers 0
